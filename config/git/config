# This is Git's per-user configuration file.

[user]
# Please adapt and uncomment the following lines:
	name = popunbom
	email = 28749104+popunbom@users.noreply.github.com

[core]
	editor = vim -c \"set fenc=utf-8\"
	quotepath = false
	autocrlf = input
	excludesfile = /Users/popunbom/.gitignore

[pager]
	branch = cat

[diff]
	tool = vimdiff

[alias]
	a = add
	b = branch -a -vv
	c = commit
	d = diff
	f = fetch
	lg = log --topo-order --stat --pretty=format:\"%C(bold)Commit:%C(reset) %C(green)%H%C(red)%d%n%C(bold)Author:%C(reset) %C(cyan)%an <%ae>%n%C(bold)Date:%C(reset)   %C(blue)%ai (%ar)%C(reset)%n%+B\"
	lg1 = log --oneline
	s = status
	au = add --update
	br = "!f(){ if type \"tig\" > /dev/null 2>&1; then tig refs; else git branch $@; fi; }; f"
	cm = commit
	co = checkout
	cl = clone
	dt = difftool -y
	ig = status --ignored
	init = "!f(){ git restore --staged .; git commit --allow-empty -m \"Initial commit\"; }; f"
	mg = merge
	ps = push
	psf = push --force
	pl = "!f(){ if [ \"$1\" == '--force' ] || [ \"$1\" == '-f' ]; then \
								echo \"git reset --hard origin/$(git rev-parse --abbrev-ref HEAD)\"; \
								git reset --hard origin/$(git rev-parse --abbrev-ref HEAD); \
							else \
								git pull $@; \
							fi; \
						}; f"
	sm = submodule
	st = stash list
	sw = switch
	rc = commit --amend -m
	pop = stash apply 
	sts = stash save 
	stc = stash clear
	uns = reset HEAD
	graph = log --graph --date-order -C -M --pretty=format:\"<%h> %ad [%an] %Cgreen%d%Creset %s\" --all --date=short
	unstage = reset HEAD
	rm-rf = "!f(){ git rm -rf .; git clean -fxd; }; f"

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
